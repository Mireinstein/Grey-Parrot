{
  "manifest_version": 3,
  "name": "Grey Parrot - Real-Time Translation",
  "version": "1.0.0",
  "description": "Real-time bidirectional translation for contact center calls",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["*://*.my.connect.aws/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.my.connect.aws/ccp-v2/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "pcm-processor.js"],
      "matches": ["*://*/*"]
    }
  ]
}
