DEEPGRAM_API_KEY=your_deepgram_key_here

# Twilio — only needed for the test softphone (test-softphone/server.py)
# Account SID + Auth Token: https://console.twilio.com → Account Info
# API Key + Secret: console.twilio.com → API keys & tokens → Create API key
# TwiML App SID: console.twilio.com → Voice → TwiML Apps → Create
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
